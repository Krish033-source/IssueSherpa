# Copy this file to .env for local development (never commit .env)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Optional: low | medium | high  (lower = faster, fewer tokens)
REASONING_EFFORT=low
# Optional but recommended: avoids GitHub API rate limits
GITHUB_TOKEN=
# Optional: AI requests allowed per IP per minute
RATE_LIMIT_PER_MIN=20
